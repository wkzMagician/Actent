{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wkzMagician/actent/schema/actent-message-v1.json",
  "title": "ActentMessage",
  "description": "Versioned cross-device content envelope used by Actent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "traceId",
    "schemaVersion",
    "createdAt",
    "source",
    "content",
    "attachments",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachment"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "appName": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": {
              "const": "url"
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "const": "image"
            }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "const": "file"
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "json"],
          "properties": {
            "type": {
              "const": "json"
            },
            "json": {}
          }
        }
      ],
      "additionalProperties": true
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mimeType", "byteLength", "handle"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "type": "string",
          "minLength": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "handle": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
